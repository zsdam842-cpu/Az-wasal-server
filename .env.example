# JWT secret — required in production
# This is a placeholder only. Never use it as the real production secret.
JWT_SECRET=change-this-in-production

# Server port (Railway sets PORT automatically)
PORT=3000

# Storage directories — use a persistent Railway Volume in production
DATA_DIR=./data
MEDIA_DIR=./media

# CORS allowed origins
CORS_ORIGIN=*

# Allowed hosts for media URLs, comma-separated.
# القيم القديمة (wasal-server-production / wasal-media-server-production)
# كانت تشير إلى خدمات غير موجودة على Railway، فكل رابط وسائط يُرفض.
MEDIA_ALLOWED_HOSTS=az-wasal-server-production.up.railway.app,az-wasal-media-server-production.up.railway.app

# خادم الوسائط والمكالمات (سجل المكالمات ونداءات ICE ورفع الملفات)
MEDIA_SERVICE_URL=https://az-wasal-media-server-production.up.railway.app
